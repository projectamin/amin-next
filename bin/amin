#!/usr/bin/env perl
use v5.38; use warnings; use utf8;
use experimental 'signatures';
BEGIN {
    use File::Basename qw(dirname);
    use Cwd qw(abs_path);
    use Config;
    my $root = abs_path(dirname(__FILE__) . '/..');

    unless ($ENV{_AMIN_EXECED}) {
        my $mise_shim = $ENV{HOME} . '/.local/share/mise/shims/perl';
        if (-x $mise_shim && $^X =~ m{^/(usr|bin|sbin|opt)}) {
            $ENV{_AMIN_EXECED} = 1;
            exec $mise_shim, __FILE__, @ARGV
                or die "exec mise perl ($mise_shim) failed: $!";
        }
        for my $d (glob($ENV{HOME} . '/.local/share/mise/installs/perl/*/*/bin/perl'),
                   glob($ENV{HOME} . '/.local/share/mise/installs/perl/*/bin/perl')) {
            if (-x $d) {
                $ENV{_AMIN_EXECED} = 1;
                exec $d, __FILE__, @ARGV
                    or die "exec mise perl ($d) failed: $!";
            }
        }
    }

    # cpanm --local-lib-contained installs to three sub-paths under ./local:
    #   lib/perl5                    (pure-perl dists, shared arch)
    #   lib/perl5/$Config{archname}  (XS modules, compiled for this perl's arch)
    #   lib/perl5/$perlver/$archname (old-style local::lib layout, just in case)
    my $arch = $Config{archname};
    my ($perlver) = $^V =~ /^v(\d+\.\d+\.\d+)/;
    unshift @INC,
        "$root/perl-lib",
        "$root/local/lib/perl5",
        "$root/local/lib/perl5/$arch",
        (defined $perlver ? ("$root/local/lib/perl5/$perlver",
                             "$root/local/lib/perl5/$perlver/$arch") : ());
}
use Getopt::Long qw(:config auto_help auto_version);
binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

our $VERSION = '3.0.0-bootstrap';
my ($LEGACY, $STREAM_OPT, $MAP_OUT, $UI_OS) = (0, 1, 'svg', 'tty');
my ($MACHINE_SPEC);
# Default to `localhost` (both loopback families), not a bare IPv4 literal:
# localhost resolves ::1 first, so a v4-only listener stalls browsers.
my $LISTEN = 'localhost:8787';
# Starman worker pool size and per-connection read timeout.
# read-timeout is the window a SILENT connection holds a worker, so it bounds
# how long a preconnect can delay other clients once the pool is busy.
my ($WORKERS, $READ_TIMEOUT) = (4, 2);
my (@INC_EXTRA, @W_PERM, @W_BEG, @W_MID, @W_LATE, @W_END);
GetOptions(
    'legacy-processing!' => \$LEGACY,
    'stream!'            => \$STREAM_OPT,
    'out=s'              => \$MAP_OUT,
    'os=s'               => \$UI_OS,
    'machine-spec=s'     => \$MACHINE_SPEC,
    'listen=s'           => \$LISTEN,
    'workers=i'          => \$WORKERS,
    'read-timeout=i'     => \$READ_TIMEOUT,
    'inc=s@'             => \@INC_EXTRA,
    'with-permanent=s'   => sub { push @W_PERM, split /,/, $_[1] },
    'with-begin=s'       => sub { push @W_BEG,  split /,/, $_[1] },
    'with-middle=s'      => sub { push @W_MID,  split /,/, $_[1] },
    'with-late=s'        => sub { push @W_LATE, split /,/, $_[1] },
    'with-end=s'         => sub { push @W_END,  split /,/, $_[1] },
) or die "bad opts\n";

for my $p (@INC_EXTRA) {
    -d $p or die "--inc path '$p' is not a directory\n";
    unshift @INC, $p;
}
if (@W_PERM || @W_BEG || @W_MID || @W_LATE || @W_END) {
    require Amin::Machine::Dispatcher;
    my $_reg = sub {
        my ($pos, $list) = @_;
        for my $cls (@$list) {
            (my $mod = "$cls.pm") =~ s{::}{/}g;
            eval { require $mod }
                or die "Cannot load --with-${pos} filter '$cls': $@";
            $cls->can('start_element')
                or die "Filter '$cls' cannot SAX handler (no start_element)\n";
            Amin::Machine::Dispatcher->register($cls, position => $pos);
        }
    };
    $_reg->('permanent' => \@W_PERM);
    $_reg->('begin'     => \@W_BEG);
    $_reg->('middle'    => \@W_MID);
    $_reg->('late'      => \@W_LATE);
    $_reg->('end'       => \@W_END);
}

my $STREAM = $LEGACY ? 0 : $STREAM_OPT;

my $MODE = { render => 1, dryrun => 1, run => 1, app => 1, map => 1, ui => 1, motd => 1 };
sub usage ($exit = 2) {
    say STDERR "Usage: $0 [--legacy-processing|--no-stream] <render|dryrun|run|app|map|ui|motd> [<path>] [--out=svg|dot|xml] [--os=ios|android|html|tty]";
    say STDERR "       $0 axa serve <app-dir> [--listen host:port] [--workers N]   persistent HTTP server (AXA)";
    say STDERR "    --legacy-processing   (alias for --no-stream) buffer and emit the full XML";
    say STDERR "                          after parsing (traditional Amin behaviour) instead of";
    say STDERR "                          streaming SAX events live to stdout (the default)";
    say STDERR "    --no-stream           disable live streaming; output XML only after parse";
    say STDERR "";
    say STDERR "  DI-2 filter extensibility (Corp third-party filters WITHOUT Amin source fork:";
    say STDERR "    --inc DIR             prepend DIR to \@INC (repeatable)";
    say STDERR "    --with-permanent=LIST comma-separated filter classes to register";
    say STDERR "                          at the permanent (non-bypassable trust position";
    say STDERR "    --with-begin=LIST     classes at begin position (routing / auth/placement)";
    say STDERR "    --with-middle=LIST    classes at middle position (commands/sandbox/network)";
    say STDERR "    --with-late=LIST      classes at late position (UI aggregation / billing report";
    say STDERR "    --with-end=LIST       classes at end position (fanout / multi-handler)";
    exit $exit;
}

# ── AXA: web layer — persistent HTTP server for an app bundle ──────────
# The whole boot cost (spec parse, bundle load, warm-up chain build) is
# paid once here; every request reuses the injected spec (plan §4.8).
if (($ARGV[0] // '') eq 'axa') {
    shift @ARGV;
    my $subcmd = shift(@ARGV) // usage(2);
    $subcmd eq 'serve' or die "Unknown axa subcommand '$subcmd' (available: serve)\n";
    my $dir = shift(@ARGV) // usage(2);
    -d $dir or die "App path must be a directory: $dir\n";
    my ($host, $port) = $LISTEN =~ /^(.+):(\d+)$/
        or die "--listen must be host:port (got '$LISTEN')\n";
    require Amin::AXA::PSGI;
    require Amin::AXA::Store::SQLite;

    # Sessions live off the heap.  Starman preforks, and a forked worker gets
    # its own copy of any in-process hash — so an in-memory cart would diverge
    # between requests (request A lands on worker 1, request B on worker 2 and
    # B has never seen A's write).  The SQLite adapter closes per worker and
    # reconnects on first use, after the fork.
    my $db = $ENV{AXA_STORE} // "$dir/axa-store.sqlite";
    my $store = Amin::AXA::Store::SQLite->new(path => $db);

    # stream => 1: the response goes to the socket as elements are generated
    # (plan §4.8), rather than buffering the whole document first.
    my $app = Amin::AXA::PSGI->app(app_dir => $dir, store => $store, stream => 1);

    # Starman parses --listen by splitting on ':', so an IPv6 *literal* like
    # [::1]:8787 breaks (starman issue #149).  Passing the symbolic hostname
    # is what works: Net::Server resolves it to both ::1 and 127.0.0.1 and
    # binds each, which preserves the dual-loopback behaviour browsers need —
    # localhost resolves ::1 first, so v4-only stalls them.
    require Plack::Handler::Starman;
    say STDERR "[axa] serving $dir — Starman, $WORKERS workers, store=$db, streaming";
    say STDERR "[axa] listening on http://$LISTEN (Ctrl-C to stop)";
    Plack::Handler::Starman->new(
        listen           => [$LISTEN],
        workers          => $WORKERS,
        # Starman's stock read-timeout is 5s, and every SILENT connection pins
        # one worker for that whole window (measured: 4 idle conns on 4
        # workers = a 5s stall, 8 = 10s).  A browser preconnect is exactly
        # such a silent connection, so keep the window short: the pool should
        # only be pinned for a moment by a client that never sends a request.
        timeout          => $READ_TIMEOUT,
        # Starman's default is 1s, which drops a real browser's second request
        # if it takes longer than that to follow a link.  5s matches what the
        # previous single-process server allowed and does not pin a NEW
        # connection — only an idle established one.
        keepalive_timeout => 5,
    )->run($app);
    exit 0;
}

my $mode = shift(@ARGV) // usage(2);
my $path = shift(@ARGV) // usage(2);
usage(2) unless $MODE->{$mode} && length($path) && -e $path;

my ($LATE_MAP, $LATE_UI) = (1, 1);
if    ($mode eq 'map') { $mode = 'render'; ($LATE_MAP, $LATE_UI) = (1, 0) }
elsif ($mode eq 'ui')  { $mode = 'render'; ($LATE_MAP, $LATE_UI) = (0, 1) }

if ($LATE_MAP) {
    $MAP_OUT =~ /^(svg|dot|xml)$/ or die "--out must be svg|dot|xml\n";
}
if ($LATE_UI) {
    $UI_OS   =~ /^(ios|android|html|tty)$/ or die "--os must be ios|android|html|tty\n";
    $ENV{AMIN_OSTYPE} = $UI_OS if $UI_OS =~ /^(ios|android)$/;
}

if ($mode eq 'app') {
    -d $path or die "App path must be a directory: $path\n";
    $path .= '/profile.xml';
    -f $path or die "App bundle missing profile.xml: $path\n";
    $mode = 'render';
}

open(my $fh, "<:encoding(UTF-8)", $path) or die "Cannot read $path: $!";
my $xml = do { local $/; <$fh> }; close $fh;

use Amin;
use Amin::Log::Standard;
use Amin::Machine::MachineSpec;

my $log     = Amin::Log::Standard->new(stderr => 1);

my $ms = Amin::Machine::MachineSpec->new(
    (defined $MACHINE_SPEC ? (path => $MACHINE_SPEC) : ()));
my $spec = $ms->spec;

my $handler_class = ($spec->{handler} && $spec->{handler}{class})
    ? $spec->{handler}{class} : 'Amin::Handler::Writer';
(my $handler_file = "$handler_class.pm") =~ s{::}{/}g;
eval { require $handler_file };
die "Cannot load machine-spec handler '$handler_class': $@" if $@;

my $writer  = $handler_class->new(
    indent    => 2,
    ($STREAM ? (fh => *STDOUT{IO}, autoflush => 1) : ()),
);
my $amin = Amin->new(Mode => $mode, Handler => $writer, Log => $log,
    late_filters_enable => { map => $LATE_MAP, ui => $LATE_UI },
    ui_os => $UI_OS, map_out => $MAP_OUT,
    (defined $MACHINE_SPEC ? (machine_spec_path => $MACHINE_SPEC) : ()));

my $out = $amin->parse($xml);
if ($STREAM) {
    STDOUT->flush;
} else {
    print $out if defined $out && length $out;
}

exit $log->error_count > 0 ? 1 : 0;
