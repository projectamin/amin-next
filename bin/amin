#!/usr/bin/env perl
use v5.38; use warnings; use utf8;
use experimental 'signatures';
BEGIN {
    use File::Basename qw(dirname);
    use Cwd qw(abs_path);
    my $root = abs_path(dirname(__FILE__) . '/..');
    unshift @INC, "$root/perl-lib";
    require Amin::Boot;
    Amin::Boot->init(__FILE__, $root);
}
use Getopt::Long qw(:config auto_help auto_version);
binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

our $VERSION = '3.0.0-bootstrap';
my ($LEGACY, $STREAM_OPT, $UI_OS) = (0, 1, 'tty');
my ($MAP_OUT, $MAP_OUT_GIVEN) = ('xml', 0);
my ($MACHINE_SPEC, $DOC_URI);
# Default to `localhost` (both loopback families), not a bare IPv4 literal:
# localhost resolves ::1 first, so a v4-only listener stalls browsers.
my $LISTEN = 'localhost:8787';
# Pre-forked worker pool size (SO_REUSEPORT, each worker its own
# Amin::Net::Loop) and the per-connection read timeout.
# read-timeout is the window a SILENT connection may idle before it is reaped;
# under the event loop an idle client costs nothing, so this only bounds how
# long a stalled request lingers before it is dropped.
my ($WORKERS, $READ_TIMEOUT) = (4, 2);
# Whether --listen/--workers were actually supplied.  `proxy serve` reads its
# bind address from the compiled config (the contract), so it must be able to
# tell an operator's override from these AXA-shaped defaults.
my ($LISTEN_GIVEN, $WORKERS_GIVEN) = (0, 0);
my (@INC_EXTRA, @W_PERM, @W_BEG, @W_MID, @W_LATE, @W_END);
GetOptions(
    'legacy-processing!' => \$LEGACY,
    'stream!'            => \$STREAM_OPT,
    'out=s'              => sub { $MAP_OUT = $_[1]; $MAP_OUT_GIVEN = 1 },
    'os=s'               => \$UI_OS,
    'machine-spec=s'     => \$MACHINE_SPEC,
    'u|uri=s'            => \$DOC_URI,
    'listen=s'           => sub { $LISTEN = $_[1]; $LISTEN_GIVEN = 1 },
    'workers=i'          => sub { $WORKERS = $_[1]; $WORKERS_GIVEN = 1 },
    'read-timeout=i'     => \$READ_TIMEOUT,
    'inc=s@'             => \@INC_EXTRA,
    'with-permanent=s'   => sub { push @W_PERM, split /,/, $_[1] },
    'with-begin=s'       => sub { push @W_BEG,  split /,/, $_[1] },
    'with-middle=s'      => sub { push @W_MID,  split /,/, $_[1] },
    'with-late=s'        => sub { push @W_LATE, split /,/, $_[1] },
    'with-end=s'         => sub { push @W_END,  split /,/, $_[1] },
) or die "bad opts\n";

for my $p (@INC_EXTRA) {
    -d $p or die "--inc path '$p' is not a directory\n";
    unshift @INC, $p;
}
if (@W_PERM || @W_BEG || @W_MID || @W_LATE || @W_END) {
    require Amin::Machine::Dispatcher;
    my $_reg = sub {
        my ($pos, $list) = @_;
        for my $cls (@$list) {
            (my $mod = "$cls.pm") =~ s{::}{/}g;
            eval { require $mod }
                or die "Cannot load --with-${pos} filter '$cls': $@";
            $cls->can('start_element')
                or die "Filter '$cls' cannot SAX handler (no start_element)\n";
            Amin::Machine::Dispatcher->register($cls, position => $pos);
        }
    };
    $_reg->('permanent' => \@W_PERM);
    $_reg->('begin'     => \@W_BEG);
    $_reg->('middle'    => \@W_MID);
    $_reg->('late'      => \@W_LATE);
    $_reg->('end'       => \@W_END);
}

my $STREAM = $LEGACY ? 0 : $STREAM_OPT;

my $MODE = { render => 1, dryrun => 1, run => 1, app => 1, map => 1, ui => 1, motd => 1 };
sub usage ($exit = 2) {
    say STDERR "Usage: $0 [--legacy-processing|--no-stream] <render|dryrun|run|app|map|ui|motd> [<path>|-u <uri>] [--out=svg|dot|xml] [--os=ios|android|html|tty]";
    say STDERR "       (AXA app bundles are served by bin/axa)";
    say STDERR "       $0 proxy serve <config> [--listen host:port] [--workers N]  persistent L7 reverse proxy";
    say STDERR "    --legacy-processing   (alias for --no-stream) buffer and emit the full XML";
    say STDERR "                          after parsing (traditional Amin behaviour) instead of";
    say STDERR "                          streaming SAX events live to stdout (the default)";
    say STDERR "    --no-stream           disable live streaming; output XML only after parse";
    say STDERR "";
    say STDERR "  DI-2 filter extensibility (Corp third-party filters WITHOUT Amin source fork:";
    say STDERR "    --inc DIR             prepend DIR to \@INC (repeatable)";
    say STDERR "    --with-permanent=LIST comma-separated filter classes to register";
    say STDERR "                          at the permanent (non-bypassable trust position";
    say STDERR "    --with-begin=LIST     classes at begin position (routing / auth/placement)";
    say STDERR "    --with-middle=LIST    classes at middle position (commands/sandbox/network)";
    say STDERR "    --with-late=LIST      classes at late position (UI aggregation / billing report";
    say STDERR "    --with-end=LIST       classes at end position (fanout / multi-handler)";
    exit $exit;
}

# ── Proxy: L7 front — persistent reverse proxy over a compiled proxy config ─
# The front is authority-free (proxy-plan §5.12): it parses, routes and pumps,
# and never mints or widens authority — backends re-authorize.  The config is
# the contract and is read ONCE (§5.13): a request may never redefine a route,
# a backend, or the listen address.  Parallels `bin/axa`: boot is paid once,
# the compiled config is injected into every request's chain.
if (($ARGV[0] // '') eq 'proxy') {
    shift @ARGV;
    my $subcmd = shift(@ARGV) // usage(2);
    $subcmd eq 'serve' or die "Unknown proxy subcommand '$subcmd' (available: serve)\n";
    my $ref = shift(@ARGV) // usage(2);

    require Amin::Proxy::Config;
    require Amin::Proxy::HTTP;
    require Amin::Log::Standard;

    my $cfg = Amin::Proxy::Config->load(ref => $ref);
    # The config names the bind address; --listen only overrides it when the
    # operator actually asked (LISTEN_GIVEN), never by falling through to the
    # AXA default.  Workers default to 1: the unit of parallelism is the loop.
    my $listen  = $LISTEN_GIVEN  ? $LISTEN  : ($cfg->listen // $LISTEN);
    my $workers = $WORKERS_GIVEN ? $WORKERS : 1;

    my $log = Amin::Log::Standard->new(stderr => 1);
    my $proxy = Amin::Proxy::HTTP->new(config => $cfg, log => $log);

    my $scheme = (defined $cfg->tls && length $cfg->tls && $cfg->tls ne 'off')
        ? 'https' : 'http';
    my $nbe = scalar keys %{ $cfg->backends };
    say STDERR "[proxy] serving $ref — $scheme, $workers worker(s), $nbe backend(s)";
    say STDERR "[proxy] listening on $listen (Ctrl-C to stop)";
    $proxy->serve(listen => $listen, workers => $workers);
    exit 0;
}

my $mode = shift(@ARGV) // usage(2);
my $MODE_REQ = $mode;
my $path = shift(@ARGV);
if (defined $DOC_URI && !defined $path) {
    $path = $DOC_URI;
}
$path // usage(2);
usage(2) unless $MODE->{$mode} && length($path);
my $is_uri = $path =~ m{\A(?:file|https?|bitcache|bc)://}i ? 1 : 0;
if ($is_uri) {
    require Amin::Machine::MachineSpec;
    my $bytes = Amin::Machine::MachineSpec::_load_uri_static($path);
    die "Cannot load URI '$path'\n" unless defined $bytes && length $bytes;
    # Write to a temp file so downstream path-based flows still work; keep the
    # original URI for diagnostics.
    require File::Temp;
    my $tmp = File::Temp->new(SUFFIX => '.xml', UNLINK => 1);
    binmode $tmp, ':raw';
    print {$tmp} $bytes;
    close $tmp;
    $DOC_URI = $path;
    $path = $tmp->filename;
} else {
    usage(2) unless -e $path;
}

my ($LATE_MAP, $LATE_UI) = (1, 1);
if    ($mode eq 'map') { $mode = 'render'; ($LATE_MAP, $LATE_UI) = (1, 0) }
elsif ($mode eq 'ui')  { $mode = 'render'; ($LATE_MAP, $LATE_UI) = (0, 1) }

# --out selects the map artifact only in `map` mode; every other mode keeps
# profile-in/profile-out semantics (map_out=xml means Topology annotates the
# profile with map:node/map:link instead of opening a render artifact).
if ($MODE_REQ eq 'map') { $MAP_OUT = 'svg' unless $MAP_OUT_GIVEN }
else                    { $MAP_OUT = 'xml' }

if ($LATE_MAP) {
    $MAP_OUT =~ /^(svg|dot|xml)$/ or die "--out must be svg|dot|xml\n";
}
if ($LATE_UI) {
    $UI_OS   =~ /^(ios|android|html|tty)$/ or die "--os must be ios|android|html|tty\n";
    $ENV{AMIN_OSTYPE} = $UI_OS if $UI_OS =~ /^(ios|android)$/;
}

if ($mode eq 'app') {
    -d $path or die "App path must be a directory: $path\n";
    $path .= '/profile.xml';
    -f $path or die "App bundle missing profile.xml: $path\n";
    $mode = 'render';
}

# Read BYTES: the document is either XML or BSAX, and BSAX's magic and length
# fields are byte offsets — an encoding layer here would corrupt it before the
# dialect is known.  Amin->parse sniffs the dialect and decodes XML itself.
open(my $fh, '<:raw', $path) or die "Cannot read $path: $!";
my $xml = do { local $/; <$fh> }; close $fh;

use Amin;
use Amin::Log::Standard;
use Amin::Machine::MachineSpec;

my $log     = Amin::Log::Standard->new(stderr => 1);

my $ms = Amin::Machine::MachineSpec->new(
    (defined $MACHINE_SPEC ? (path => $MACHINE_SPEC) : ()));
my $spec = $ms->spec;

my $handler_class = ($spec->{handler} && $spec->{handler}{class})
    ? $spec->{handler}{class} : 'Amin::Handler::Writer';
# --os=html renders the ui: IR into XHTML events, so the dumb HTML serializer
# replaces the spec's XML writer for that target (the spec declares
# Amin::Handler::Writer for the XML/map modes).  It ignores `indent`.
$handler_class = 'Amin::Handler::HTML' if $LATE_UI && $UI_OS eq 'html';
# `map --out=svg|dot` produces a standalone artifact: the map target emits the
# drawing as events (svg:*) or one map-dot stream fragment, and a dumb
# serializer keeps only that artifact.  --out=xml keeps the XML writer.
$handler_class = 'Amin::Handler::SVG' if $MODE_REQ eq 'map' && $MAP_OUT eq 'svg';
$handler_class = 'Amin::Handler::DOT' if $MODE_REQ eq 'map' && $MAP_OUT eq 'dot';
(my $handler_file = "$handler_class.pm") =~ s{::}{/}g;
eval { require $handler_file };
die "Cannot load machine-spec handler '$handler_class': $@" if $@;

my $writer  = $handler_class->new(
    indent    => 2,
    ($STREAM ? (fh => *STDOUT{IO}, autoflush => 1) : ()),
);
my $amin = Amin->new(Mode => $mode, Handler => $writer, Log => $log,
    late_filters_enable => { map => $LATE_MAP, ui => $LATE_UI },
    ui_os => $UI_OS, map_out => $MAP_OUT,
    (defined $MACHINE_SPEC ? (machine_spec_path => $MACHINE_SPEC) : ()));

my $out = $amin->parse($xml);
if ($STREAM) {
    STDOUT->flush;
} else {
    print $out if defined $out && length $out;
}

# Parenthesise the whole ternary: `exit` is a named unary operator and binds
# tighter than `>`, so `exit $n > 0 ? 1 : 0` is really `exit($n)` and the
# process would exit with the raw error count instead of 1.
exit($log->error_count > 0 ? 1 : 0);
