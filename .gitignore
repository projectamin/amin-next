# ── Perl 5 / Amin specific ──────────────────────────────────────────
# Local CPAN installs (bootstrap task: cpanm --local-lib ./local)
/local/
/local-lib/
/extlib/
/lib/
/.cpanm/
/.cache/
/cpanfile.snapshot
/perl-local/
# Build artifacts
/Makefile
/Makefile.old
/pm_to_blib
/blib/
*.bs
# Misplaced .pl temp files from Perl REPLs
/*.bak
# Mise + mise local installs (mise run bootstrap writes these)
/.mise/
/.mise.toml.local
/install-cache/
# Perl cover / Devel::Cover
cover_db/
*.lcov
# Test temp files
/tmp/
/_build/
/Build
/Build.bat
# Test2 harness temp
/.test-env/

# ── Rust / Cargo specific ──────────────────────────────────────────
# Cargo workspace build artifacts (CARGO_TARGET_DIR=$ROOT/target per .mise.toml)
/target/
**/target/
# Cargo.lock for libraries; we pin binaries so keep it!  (Explicitly NOT gitignored)
# Uncomment next line if this becomes a pure-library workspace only:
# /rust/target/Cargo.lock

# ── Editors ──────────────────────────────────────────────────────────
*~
.#*
.*.swp
.*.swo
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
.trae/

# ── Amin runtime artifacts ──────────────────────────────────────────
# *.aminsig detached signatures written for releases; dev signatures are fine
# but locally generated test sigs should not be committed:
/*.test.aminsig
# Per-run streamed outputs
/*.xml.out
/*.stderr
/*.stdout
# SQLite audit log (v3 default storage for audit trail)
/audit-log.db
/audit-log.db-*
# Snapshot files generated by prove
/t/SNAPSHOT-*.t.bak

# ── CI / build output ───────────────────────────────────────────────
/dist/
/artifacts/
/release-notes.md.tmp

# ── Local working scratchpads / transient docs ──────────────────────
# Commit message scratchpad with cut-markers; never committed.  Users
# pass it to `git commit -F <(sed …)` then discard.
.COMMIT_MSG.md
.COMMIT_MSG.md.bak
*.local.md
