<?xml version="1.0" encoding="UTF-8"?>
<!--
  shop-ui app declarations (AXA first pass).

  Each route/action declares the fragment the app sends for that path —
  in the app's own dialect (urn:projectamin:example:shop).  {placeholders}
  are substituted by Amin::AXA::FormCodec from request data: the bundle
  declares the fragment, the transport only supplies values (plan §4.2 —
  encodings are not dialects).

  xmlns:shop is repeated on every fragment root: Amin::AXA::App serialises
  child nodes individually, so a declaration on <axa:app> does not travel with
  them, and the server declares no app dialect of its own.  The filters that
  speak the dialect are declared in this bundle's machine_spec.xml.
-->
<axa:app xmlns:axa="http://projectamin.org/ns/axa/1"
         xmlns:shop="urn:projectamin:example:shop"
         id="io.projectamin.apps.shop-ui"
         name="shop-ui">

  <axa:route path="/" method="GET">
    <shop:request xmlns:shop="urn:projectamin:example:shop" route="catalog" sid="{sid}" csrf="{csrf}"/>
  </axa:route>

  <axa:route path="/product" method="GET">
    <shop:request xmlns:shop="urn:projectamin:example:shop" route="product" sku="{sku}" sid="{sid}" csrf="{csrf}"/>
  </axa:route>

  <axa:route path="/cart" method="GET">
    <shop:request xmlns:shop="urn:projectamin:example:shop" route="cart" sid="{sid}" csrf="{csrf}"/>
  </axa:route>

  <axa:action name="cart.add" path="/cart" method="POST">
    <shop:action xmlns:shop="urn:projectamin:example:shop" name="cart.add" sku="{sku}" qty="{qty}" sid="{sid}" csrf="{csrf}"/>
  </axa:action>

  <axa:action name="cart.set_qty" path="/cart" method="POST">
    <shop:action xmlns:shop="urn:projectamin:example:shop" name="cart.set_qty" sku="{sku}" qty="{qty}" sid="{sid}" csrf="{csrf}"/>
  </axa:action>

  <axa:action name="cart.remove" path="/cart" method="POST">
    <shop:action xmlns:shop="urn:projectamin:example:shop" name="cart.remove" sku="{sku}" sid="{sid}" csrf="{csrf}"/>
  </axa:action>

  <!-- A byte-exact plain-text route with a path template.  `type=` picks the
       serializer (the route's media type, independent of the filter set) and
       the `:who` segment is captured from the path and substituted like any
       other value — the same mechanism an ACME HTTP-01 challenge uses. -->
  <axa:route path="/hello/:who" method="GET" type="text/plain">Hello, {who}!</axa:route>

</axa:app>
