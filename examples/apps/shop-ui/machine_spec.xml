<?xml version="1.0" encoding="UTF-8"?>
<!--
  shop-ui machine spec (explicit app contract).

  AXA loads only this spec.  It includes the stock Amin core filters and then
  declares the app's own filters.  No auto-discovery or runtime merge.
-->
<amin:machine xmlns:amin="http://projectamin.org/ns/2026/" name="shop-ui">
  <amin:include spec="amin-core" />

  <filter class="Amin::Example::Shop" position="middle"
          element="request" namespace="urn:projectamin:example:shop" />

  <filter class="Amin::Example::Shop" position="middle"
          element="action" namespace="urn:projectamin:example:shop" />

</amin:machine>
