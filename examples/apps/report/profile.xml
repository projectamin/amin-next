<?xml version="1.0" encoding="UTF-8"?>
<!--
  report — a document-generation profile.  `amin render examples/apps/report/profile.xml`
  streams the sheet grammar through the late-region Document filter, which
  writes a deterministic XLSX artifact into the CAS and emits one
  amin:result plus a compact bc:object ref.  `amin run …` additionally
  materialises the bytes under amin:root/out when a zcap scope is present.

  The document grammar is platform vocabulary, so it lives in the core amin:
  namespace.  Application or Rust-supplied filters keep their own namespace
  URIs and cannot collide with the core grammar.
-->
<amin:profile xmlns:amin="http://projectamin.org/ns/2026/"
              amin:id="io.projectamin.apps.report">

  <amin:document format="xlsx"
                 title="Quarterly Revenue"
                 author="Amin"
                 subject="Q3 revenue by region"
                 out="out/report.xlsx">

    <amin:style id="hdr" bold="1" fill="#DDEEFF" align="center"/>
    <amin:style id="money" numfmt="#,##0.00"/>
    <amin:style id="pct" numfmt="0.0%"/>

    <amin:sheet name="Revenue" tab-color="#00AA00">
      <amin:column index="1" width="28"/>
      <amin:column index="2" width="16"/>
      <amin:freeze ref="A2"/>
      <amin:autofilter ref="A1:C5"/>
      <amin:merge ref="A7:C7"/>

      <amin:row r="1" height="20">
        <amin:cell type="string" style="hdr">Region</amin:cell>
        <amin:cell type="string" style="hdr">Revenue</amin:cell>
        <amin:cell type="string" style="hdr">YoY</amin:cell>
      </amin:row>

      <amin:row r="2">
        <amin:cell type="string">North America</amin:cell>
        <amin:cell type="number" style="money">1284450.50</amin:cell>
        <amin:cell type="number" style="pct">0.124</amin:cell>
      </amin:row>

      <amin:row r="3">
        <amin:cell type="string">Europe</amin:cell>
        <amin:cell type="number" style="money">988210.00</amin:cell>
        <amin:cell type="number" style="pct">0.081</amin:cell>
      </amin:row>

      <amin:row r="4">
        <amin:cell type="string">Asia Pacific</amin:cell>
        <amin:cell type="number" style="money">735900.25</amin:cell>
        <amin:cell type="number" style="pct">0.163</amin:cell>
      </amin:row>

      <amin:row r="5">
        <amin:cell type="string">Total</amin:cell>
        <amin:cell type="formula" style="money">=SUM(B2:B4)</amin:cell>
        <amin:cell type="blank"/>
      </amin:row>

      <amin:row r="7">
        <amin:cell type="string" style="hdr">Generated by the Amin content filter</amin:cell>
      </amin:row>
    </amin:sheet>

    <amin:sheet name="Notes">
      <amin:row>
        <amin:cell type="string">Figures are illustrative.</amin:cell>
      </amin:row>
      <amin:row>
        <amin:cell type="date">2026-09-30</amin:cell>
      </amin:row>
    </amin:sheet>
  </amin:document>
</amin:profile>
